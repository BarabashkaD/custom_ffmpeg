# GenerateConfig.cmake
# Generates a .env file consumed by build/build_ffmpeg.sh inside the Docker container.
#
# Required inputs (pass via -D):
#   TARGET_PLATFORM   windows-x64 | linux-x64 | macos-arm64
#   BUILD_TYPE        static | shared
#   PROFILE           minimal | full | custom
#   OUTPUT_DIR        directory where the .env file is written
#   PROFILES_DIR      directory containing <profile>.cmake files (default: ../profiles)
#
# FFmpeg version is tracked via git submodule — not set here.
# LAME version/url is read from versions.cmake.

cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED PROFILES_DIR)
    set(PROFILES_DIR "${CMAKE_CURRENT_LIST_DIR}/../profiles")
endif()

# Always load versions for LAME and other non-submodule deps
include("${CMAKE_CURRENT_LIST_DIR}/../versions.cmake")

# Load profile
set(_profile_file "${PROFILES_DIR}/${PROFILE}.cmake")
if(NOT EXISTS "${_profile_file}")
    message(FATAL_ERROR "Profile not found: ${_profile_file}")
endif()
include("${_profile_file}")

# Profile sections per platform: <VAR>_WINDOWS / _LINUX / _MACOS
if(TARGET_PLATFORM MATCHES "^windows-")
    set(_os WINDOWS)
elseif(TARGET_PLATFORM MATCHES "^linux-")
    set(_os LINUX)
elseif(TARGET_PLATFORM MATCHES "^macos-")
    set(_os MACOS)
else()
    message(FATAL_ERROR "Unknown TARGET_PLATFORM: ${TARGET_PLATFORM}")
endif()

# Build FFmpeg configure flags from profile variables
set(_flags "")

if(FFMPEG_DISABLE_EVERYTHING)
    string(APPEND _flags "--disable-everything ")
endif()
if(FFMPEG_DISABLE_PROGRAMS)
    string(APPEND _flags "--disable-programs ")
endif()
if(FFMPEG_DISABLE_DOC)
    string(APPEND _flags "--disable-doc ")
endif()
foreach(_lib IN LISTS FFMPEG_DISABLE_LIBS)
    string(APPEND _flags "--disable-${_lib} ")
endforeach()
foreach(_lib IN LISTS FFMPEG_ENABLE_LIBS)
    string(APPEND _flags "--enable-${_lib} ")
endforeach()
foreach(_dec IN LISTS FFMPEG_ENABLE_DECODERS)
    string(APPEND _flags "--enable-decoder=${_dec} ")
endforeach()
foreach(_enc IN LISTS FFMPEG_ENABLE_ENCODERS)
    string(APPEND _flags "--enable-encoder=${_enc} ")
endforeach()
foreach(_proto IN LISTS FFMPEG_ENABLE_PROTOCOLS)
    string(APPEND _flags "--enable-protocol=${_proto} ")
endforeach()
# Extra flags from profile (e.g. --enable-libx264 --enable-gpl)
foreach(_extra IN LISTS FFMPEG_CONFIGURE_EXTRA FFMPEG_CONFIGURE_EXTRA_${_os})
    string(APPEND _flags "${_extra} ")
endforeach()

if(BUILD_TYPE STREQUAL "shared")
    string(APPEND _flags "--enable-shared --disable-static")
else()
    string(APPEND _flags "--disable-shared --enable-static")
endif()

string(STRIP "${_flags}" _flags)

# config.h symbols (CONFIG_<NAME> or HAVE_<NAME>) that must be 1 after configure — checked by
# build_ffmpeg.sh so a silently disabled lib/encoder/decoder fails the build
set(_required "")
foreach(_lib IN LISTS FFMPEG_ENABLE_LIBS)
    list(APPEND _required "${_lib}")
endforeach()
foreach(_enc IN LISTS FFMPEG_ENABLE_ENCODERS FFMPEG_REQUIRED_ENCODERS)
    list(APPEND _required "${_enc}_encoder")
endforeach()
foreach(_dec IN LISTS FFMPEG_ENABLE_DECODERS)
    list(APPEND _required "${_dec}_decoder")
endforeach()
foreach(_name IN LISTS FFMPEG_REQUIRED FFMPEG_REQUIRED_${_os})
    list(APPEND _required "${_name}")
endforeach()
list(REMOVE_DUPLICATES _required)
list(JOIN _required " " _required)
string(TOUPPER "${_required}" _required)

# Common LAME block (same for all platforms)
set(_lame_env
"LAME_VERSION=${LAME_VERSION}
LAME_URL=${LAME_URL}
LAME_TARBALL=${LAME_TARBALL}
LAME_SHA256=${LAME_SHA256}")

# Platform-specific sections
if(TARGET_PLATFORM STREQUAL "windows-x64")
    include("${CMAKE_CURRENT_LIST_DIR}/FindWindowsSDK.cmake")

    # Container mount points (2 bind mounts: kits root + msvc versioned dir)
    # SDK version and sub-paths are resolved inside the container by build_ffmpeg.sh
    set(_env
"# Generated by cmake/GenerateConfig.cmake — DO NOT EDIT
TARGET_PLATFORM=${TARGET_PLATFORM}
BUILD_TYPE=${BUILD_TYPE}
PROFILE=${PROFILE}

TARGET_OS=win64
ARCH=x86_64
TARGET_TRIPLE=x86_64-pc-windows-msvc

FFMPEG_CONFIGURE_FLAGS='${_flags}'
FFMPEG_REQUIRED_CONFIG='${_required}'
FFMPEG_EXPECTED_LICENSE='${FFMPEG_EXPECTED_LICENSE}'

${_lame_env}

# Host paths — used by build.ps1 to set up 2 bind mounts into /winsdk/
WINSDK_HOST_KITS_ROOT='${WINSDK_KITS_ROOT}'
MSVC_HOST_DIR='${MSVC_BASE_DIR}'
")

elseif(TARGET_PLATFORM STREQUAL "linux-x64")
    set(_env
"# Generated by cmake/GenerateConfig.cmake — DO NOT EDIT
TARGET_PLATFORM=${TARGET_PLATFORM}
BUILD_TYPE=${BUILD_TYPE}
PROFILE=${PROFILE}

TARGET_OS=linux
ARCH=x86_64
TARGET_TRIPLE=x86_64-linux-gnu

FFMPEG_CONFIGURE_FLAGS='${_flags}'
FFMPEG_REQUIRED_CONFIG='${_required}'
FFMPEG_EXPECTED_LICENSE='${FFMPEG_EXPECTED_LICENSE}'

${_lame_env}
")

elseif(TARGET_PLATFORM STREQUAL "macos-arm64")
    set(_env
"# Generated by cmake/GenerateConfig.cmake — DO NOT EDIT
TARGET_PLATFORM=${TARGET_PLATFORM}
BUILD_TYPE=${BUILD_TYPE}
PROFILE=${PROFILE}

TARGET_OS=darwin
ARCH=arm64
TARGET_TRIPLE=arm64-apple-macos12

FFMPEG_CONFIGURE_FLAGS='${_flags}'
FFMPEG_REQUIRED_CONFIG='${_required}'
FFMPEG_EXPECTED_LICENSE='${FFMPEG_EXPECTED_LICENSE}'

${_lame_env}
")

else()
    message(FATAL_ERROR "Unknown TARGET_PLATFORM: ${TARGET_PLATFORM}")
endif()

file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(_out "${OUTPUT_DIR}/${TARGET_PLATFORM}-${BUILD_TYPE}-${PROFILE}.env")
# Always write LF line endings — file is sourced by bash inside Docker (Linux)
file(CONFIGURE OUTPUT "${_out}" CONTENT "${_env}" NEWLINE_STYLE LF)
message(STATUS "Config written: ${_out}")

# For windows-x64: generate a companion .json with SDK mount paths so
# manual docker run commands don't need hardcoded paths or MSVC versions.
# JSON is read with ConvertFrom-Json — no PowerShell execution policy required.
if(TARGET_PLATFORM STREQUAL "windows-x64")
    set(_json_out "${OUTPUT_DIR}/${TARGET_PLATFORM}-${BUILD_TYPE}-${PROFILE}.json")
    set(_json
"{
  \"WINSDK_HOST_KITS_ROOT\": \"${WINSDK_KITS_ROOT}\",
  \"MSVC_HOST_DIR\": \"${MSVC_BASE_DIR}\",
  \"WINSDK_VERSION\": \"${WINSDK_VERSION}\",
  \"MSVC_VERSION\": \"${MSVC_VERSION}\"
}
")
    file(CONFIGURE OUTPUT "${_json_out}" CONTENT "${_json}" NEWLINE_STYLE CRLF)
    message(STATUS "JSON vars written: ${_json_out}")
endif()
